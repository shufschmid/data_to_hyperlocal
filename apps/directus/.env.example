####################################################################################################
## Local development only.
##
## Copy to `.env` (`npm run setup` does it for you) and fill in ANTHROPIC_API_KEY.
## `.env` is gitignored — never commit it.
##
## In Docker these values come from the repo-root `.env` via docker-compose.yml,
## not from this file. Add a new variable in BOTH places, and document it in
## apps/directus/CLAUDE.md.
####################################################################################################

####################################################################################################
## General

PORT=8055
PUBLIC_URL="http://localhost:8055"

# Directus default is 1mb. Raise it if you accept large payloads (base64 in a JSON
# body is ~33% larger than the file).
MAX_PAYLOAD_SIZE="15mb"

# Named zone, not UTC: scheduled Flows fire in the process timezone, so a cron of
# `0 7` means 07:00 Swiss wall-clock year-round (CET/CEST) with this set.
TZ="Europe/Zurich"

####################################################################################################
## Database — matches docker-compose.yaml in this folder

DB_CLIENT="pg"
DB_HOST="127.0.0.1"
DB_PORT="5432"
DB_DATABASE="directus"
DB_USER="postgres"
DB_PASSWORD="password"
DB_SSL="false"

####################################################################################################
## Claude API — the only language model this stack talks to.
## There is no local model and no GPU: get a key at https://console.anthropic.com.

ANTHROPIC_API_KEY=""
# Optional. Code default: claude-sonnet-5 (see extensions/app/src/shared/claude.ts).
ANTHROPIC_MODEL="claude-sonnet-5"

# Kontaktadresse im User-Agent der Agenda-Abfrage. Siehe shared/agenda/index.ts.
AGENDA_KONTAKT="it@bajour.ch"

####################################################################################################
## FaaS-Crawler — rendert Seiten, die ohne Browser nichts hergeben.
##
## Noetig fuer die Sportresultate: das Match Center des Fussballverbands weist
## einfache Anfragen mit 403 ab und baut seine Tabellen erst im Browser auf,
## und der Game Center von Swiss Volley liefert seine Spiele per RSC nach.
## Ohne diese Werte laeuft alles andere weiter, die Sportresultate nicht.

CRAWLER_URL="https://crawler.wepublish.dev"
CRAWLER_KEY=""
CRAWLER_TIMEOUT_MS="90000"

####################################################################################################
## Security
##
## Generate real values before deploying: `openssl rand -hex 32` for each.
## The local defaults below are fine for a throwaway dev database and nowhere else.

KEY="59ccea19-23112-4a08-8sw72-dd2312341412"
SECRET="1234"

ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"
REFRESH_TOKEN_COOKIE_SECURE=false
REFRESH_TOKEN_COOKIE_SAME_SITE="lax"
REFRESH_TOKEN_COOKIE_NAME="directus_refresh_token"

AUTH_PROVIDERS=""

####################################################################################################
## Rate limiting

RATE_LIMITER_ENABLED=false
RATE_LIMITER_STORE=memory
RATE_LIMITER_POINTS=25
RATE_LIMITER_DURATION=1

####################################################################################################
## Cache

CACHE_ENABLED=false

####################################################################################################
## File storage
##
## Directus Files is the ONLY place this application may store binaries. Application
## code never writes to the filesystem — see the storage rule in CLAUDE.md. In Docker
## this path is a named volume so uploads survive a redeploy.

STORAGE_LOCATIONS="local"
STORAGE_LOCAL_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads"

####################################################################################################
## Extensions
##
## All server-side logic lives in extensions/app (one bundle). EXTENSIONS_AUTO_RELOAD
## picks up a rebuild without restarting Directus — dev only.

EXTENSIONS_PATH="./extensions"
EXTENSIONS_AUTO_RELOAD=true

####################################################################################################
## CORS — dev only. Lock this down for anything reachable from the internet.

CORS_ENABLED=true
CORS_ORIGIN="http://localhost:3000"

####################################################################################################
## Email — optional. Without SMTP, Directus logs mails instead of sending them.

EMAIL_FROM="no-reply@example.com"
EMAIL_TRANSPORT="sendmail"
# EMAIL_TRANSPORT="smtp"
# EMAIL_SMTP_HOST=""
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=""
# EMAIL_SMTP_PASSWORD=""
# EMAIL_SMTP_SECURE=false

####################################################################################################
## Frontend URLs Directus needs to know about

PASSWORD_RESET_URL_ALLOW_LIST="http://localhost:3000/auth/set-new-password"
USER_INVITE_URL_ALLOW_LIST="http://localhost:3000/auth/accept-invite"
USER_INVITE_TOKEN_TTL="14d"

####################################################################################################
## directus-sync (schema as code)
##
## `npm run schema:dump` / `npm run schema:load` talk to a RUNNING Directus with
## this token. Create it in the admin UI: User Directory → your admin user →
## Token → generate, then paste it here.

DIRECTUS_URL="http://localhost:8055"
DIRECTUS_TOKEN=""

REDAKTION_TOKEN_TTL_TAGE="14"

####################################################################################################
## Die zwei Sendungen: SRF Regionaljournal Basel Baselland und punkt6 (Telebasel)
##
## Beide kommen als SMD-Transkript-PDF ins SELBE Postfach — getrennt werden sie
## nur ueber den Betreff-Filter. Fehlen diese Werte, bleiben die zwei Reiter
## leer und sagen es; alles andere im Dashboard merkt nichts davon.

IMAP_HOST=""
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
IMAP_SUBJECT_FILTER=""
PUNKT6_IMAP_SUBJECT_FILTER="punkt6neu"

## SRGSSR Audio Metadata API (OAuth2) — loest je Beitrag die Audio-Datei auf.
## Bewusst optional gelesen: fehlende Zugangsdaten scheitern JE BEITRAG als
## resolution_error, nie als Absturz des ganzen Dossiers.
SRGSSR_CLIENT_ID=""
SRGSSR_CLIENT_SECRET=""
SRGSSR_SHOW_ID=""

## Oeffentliche Blog-API (Konvention wepublish-rest/1, offener Modus R4a)
## Der Dorfkoenig liest die publizierten Beitraege unter /api/v1/artikel.
## Alles, was diese Schnittstelle liefert, steht ohnehin oeffentlich im Blog —
## ein Schluessel schuetzte nichts. Darum kein Merkmal, aber ein AUSDRUECKLICHER
## Schalter: leer heisst abgeschaltet (die Inhaltspfade antworten 503), "ja"
## heisst offen. Nie ein Rueckfall — eine Schnittstelle, die ohne Absicht offen
## ist, ist es zu unrecht.
BLOG_API_OFFEN=""

## Die Kennung des Mediums, das diese Instanz traegt (ASCII, snake_case).
## Der Dorfkoenig liest mehrere Redaktionen und muss wissen, wer spricht: die
## Kennung steht in /api/v1/gesundheit und auf jedem Beitrag. Leer heisst
## "unbenannt" — die Schnittstelle bleibt offen und sagt es.
REDAKTION_MEDIUM=""

## Sokrates-Schnittstelle (/sokrates/sendungen) — geschuetzt, NICHT oeffentlich.
## Sokrates ist die KI hinter der "Frage des Tages": sie liest die neuen
## Regionaljournal-Sendungen UNGEPRUEFT und schnell (Abschnitte + ganzes
## Transkript), was der Dorfkoenig nie bekommt. Der Schluessel kommt als
## Kopfzeile "X-Sokrates-Key: <Schluessel>" — NICHT als Authorization: die
## gehoert Directus, dessen Auth-Middleware fremde Bearer-Tokens abweist.
## Leer heisst abgeschaltet (503).
SOKRATES_API_KEY=""

## Der Editor-Zugang (POST /redaktion/editor-zugang): eine Redaktorin oeffnet
## die Redaktion als External App im We.Publish-Editor und ist angemeldet, ohne
## sich ein zweites Mal anzumelden. EDITOR_API_URL ist die Adresse der
## Editor-API, an der /external-apps/userinfo das kurzlebige Token bestaetigt.
## EDITOR_HERKUNFT ist die HERKUNFT, unter der DIESE Instanz im Editor als
## External App eingetragen ist (nackt, also ohne Pfad und ohne Schraegstrich am
## Ende) — das Token traegt sie als "aud", und ohne diese Pruefung wuerde ein
## Token, das fuer eine ANDERE External App desselben Hauses ausgestellt wurde,
## hier eine Sitzung kaufen. Beide leer heissen abgeschaltet (503), und die Tuer
## sagt es. Es wird nie ein Benutzer angelegt: wer fehlt, bekommt eine deutsche
## Meldung und wird in der Admin-UI erfasst.
EDITOR_API_URL=""
EDITOR_HERKUNFT=""

## Die REST-Tuer des Zettelkastens (Konvention wepublish-rest/1): die amtlichen
## Publikationen beider Basel seit 2018, je mit Rohablage und Pruefsumme.
## Gelesen wird sie nur fuer die Vorgeschichte einer Zeile, die eine Redaktorin
## ansieht, und nur fuer Organisationen; Konkurse, Betreibungen und Erbschaften
## bleiben draussen. Leer heisst abgeschaltet: der Abschnitt am Amtsblatt-Tisch
## bleibt leer und sagt, dass der Zettelkasten nicht angeschlossen ist.
ZETTELKASTEN_URL="https://zettelkasten-tuer.raumschiffenterprise.ch"
ZETTELKASTEN_TOKEN=""
ZETTELKASTEN_MANDANT="bajour"
