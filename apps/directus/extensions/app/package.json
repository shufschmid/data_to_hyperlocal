{
  "name": "app",
  "description": "All server-side logic of this application, as a single Directus extension bundle.",
  "icon": "extension",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "operation",
        "name": "quellen-pruefen",
        "source": {
          "app": "src/operations/quellen-pruefen/app.ts",
          "api": "src/operations/quellen-pruefen/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "portal-inventur",
        "source": {
          "app": "src/operations/portal-inventur/app.ts",
          "api": "src/operations/portal-inventur/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "sportresultate-holen",
        "source": {
          "app": "src/operations/sportresultate-holen/app.ts",
          "api": "src/operations/sportresultate-holen/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "entsorgung-publizieren",
        "source": {
          "app": "src/operations/entsorgung-publizieren/app.ts",
          "api": "src/operations/entsorgung-publizieren/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "wochenblatt-pruefen",
        "source": {
          "app": "src/operations/wochenblatt-pruefen/app.ts",
          "api": "src/operations/wochenblatt-pruefen/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "amtsblatt-pruefen",
        "source": {
          "app": "src/operations/amtsblatt-pruefen/app.ts",
          "api": "src/operations/amtsblatt-pruefen/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "redaktion-abarbeiten",
        "source": {
          "app": "src/operations/redaktion-abarbeiten/app.ts",
          "api": "src/operations/redaktion-abarbeiten/api.ts"
        }
      },
      {
        "type": "endpoint",
        "name": "redaktion",
        "source": "src/endpoints/redaktion/index.ts"
      },
      {
        "type": "endpoint",
        "name": "api",
        "source": "src/endpoints/api/index.ts"
      },
      {
        "type": "hook",
        "name": "kandidat-gemeinde",
        "source": "src/hooks/kandidat-gemeinde/index.ts"
      },
      {
        "type": "hook",
        "name": "meldung-status",
        "source": "src/hooks/meldung-status/index.ts"
      },
      {
        "type": "hook",
        "name": "ankuendigung-schluessel",
        "source": "src/hooks/ankuendigung-schluessel/index.ts"
      },
      {
        "type": "hook",
        "name": "entsorgung-termin",
        "source": "src/hooks/entsorgung-termin/index.ts"
      },
      {
        "type": "endpoint",
        "name": "dossier-process",
        "source": "src/endpoints/dossier-process/index.ts"
      },
      {
        "type": "endpoint",
        "name": "dossiers-ingest",
        "source": "src/endpoints/dossiers-ingest/index.ts"
      },
      {
        "type": "endpoint",
        "name": "punkt6-dossier-process",
        "source": "src/endpoints/punkt6-dossier-process/index.ts"
      },
      {
        "type": "endpoint",
        "name": "punkt6-dossiers-ingest",
        "source": "src/endpoints/punkt6-dossiers-ingest/index.ts"
      },
      {
        "type": "operation",
        "name": "dossiers-ingest-imap",
        "source": {
          "app": "src/operations/dossiers-ingest-imap/app.ts",
          "api": "src/operations/dossiers-ingest-imap/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "dossiers-process-pending",
        "source": {
          "app": "src/operations/dossiers-process-pending/app.ts",
          "api": "src/operations/dossiers-process-pending/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "punkt6-dossiers-ingest-imap",
        "source": {
          "app": "src/operations/punkt6-dossiers-ingest-imap/app.ts",
          "api": "src/operations/punkt6-dossiers-ingest-imap/api.ts"
        }
      },
      {
        "type": "operation",
        "name": "punkt6-dossiers-process-pending",
        "source": {
          "app": "src/operations/punkt6-dossiers-process-pending/app.ts",
          "api": "src/operations/punkt6-dossiers-process-pending/api.ts"
        }
      }
    ],
    "host": "^11.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "add": "directus-extension add",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@directus/errors": "^2.1.0",
    "imapflow": "^1.0.191",
    "mailparser": "^3.7.4",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "17.1.4",
    "@directus/types": "13.4.0",
    "@types/express": "4.17.21",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.30",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4",
    "vue": "3.5.24"
  }
}
